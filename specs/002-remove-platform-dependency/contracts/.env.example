# 计划中的独立配置模板；实现时替换 existing_app/.env.example。
# 复制到不提交的 .env.local；以下空值必须自行配置，禁止提交真实值。
POSTGRES_USER=pathmate
POSTGRES_PASSWORD=
POSTGRES_DB=pathmate
DATABASE_URL=
# 测试库必须独立，数据库名以 _test 结尾，禁止指向开发库。
DATABASE_URL_TEST=
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
SESSION_TTL_SECONDS=86400
CARE_INVITE_TTL_SECONDS=600
LOG_LEVEL=info
DEMO_ACCOUNT_ENABLED=true
# 可选地图Key，浏览器可见；不可放入Git，限制允许使用来源。
VITE_AMAP_KEY=
